# Copy to deploy/.env before running the production profile:
#   copy deploy\.env.example deploy\.env      (PowerShell)
#   cp deploy/.env.example deploy/.env        (POSIX)
#
# Placeholders only. Replace every value before a real deployment; never commit
# deploy/.env (it is git-ignored).

# --- Required by config.settings.prod --------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-64-byte-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080

# --- Webhook and connector secrets (required by config.settings.prod) -------
# The api/worker/beat containers refuse to start while any of these is empty
# or still holds a development placeholder.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYMENT_WEBHOOK_SECRET=
MESSAGING_WEBHOOK_SECRET=
# A Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_KEY=

# --- Database (compose db service) -----------------------------------------
POSTGRES_USER=enamel
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=enamel

# --- Database roles (ADR-013) -----------------------------------------------
# The api service connects as `enamel_app` and the worker/beat as
# `enamel_worker`; the row-level-security policies are IN FORCE for them.
# The migration step uses the owner URL; the platform-admin service has its
# own credential.
ENAMEL_APP_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_WORKER_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_MAINT_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_ADMIN_DB_PASSWORD=replace-with-a-strong-role-password
# The owner URL. It is used by the "migrate" service only: the runtime
# services (api, worker, beat, admin, ops) never receive it, so a
# code-execution foothold in a runtime container cannot escalate to the owner.
# The platform-admin service has its own credential (ADMIN_DATABASE_URL).
DATABASE_MIGRATION_URL=postgresql://enamel:replace-with-a-strong-database-password@db:5432/enamel
# The runtime URLs. The rollback of the role switch is to point these at the
# owner URL and restart the services.
API_DATABASE_URL=postgresql://enamel_app:replace-with-a-strong-role-password@db:5432/enamel
WORKER_DATABASE_URL=postgresql://enamel_worker:replace-with-a-strong-role-password@db:5432/enamel
MAINT_DATABASE_URL=postgresql://enamel_maint:replace-with-a-strong-role-password@db:5432/enamel
ADMIN_DATABASE_URL=postgresql://enamel_admin:replace-with-a-strong-role-password@db:5432/enamel
# The platform-admin service listens on its own port; it is not proxied by
# the public web service.
ADMIN_PORT=8091
ADMIN_WORKERS=2
ADMIN_TIMEOUT=60

# --- Stack tuning ----------------------------------------------------------
WEB_PORT=8080
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
TIME_ZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
LOG_LEVEL=INFO
# Leave false for the local HTTP demo; set true when TLS terminates upstream.
SECURE_SSL_REDIRECT=false

# --- Offline-safe adapters (do not label these as live integrations) --------
AI_PROVIDER=mock
AI_MOCK_MODE=true
MESSAGING_ADAPTER=dev
PAYMENT_GATEWAY=sandbox
RCM_ENABLED=false

# --- Optional live credentials (leave blank; never commit real values) ------
OPENROUTER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
