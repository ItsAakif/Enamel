# Enamel - local development environment.
# Copy to .env and adjust. Never commit real secrets (placeholders only here).

SECRET_KEY=replace-with-a-random-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
# MEDIA_ROOT=backend/media
TIME_ZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
LOG_LEVEL=INFO

# PostgreSQL 17 + pgvector (docker compose -f deploy/docker-compose.yml)
DATABASE_URL=postgresql://enamel:replace-with-a-strong-local-password@127.0.0.1:5433/enamel
POSTGRES_USER=enamel
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=enamel

# The database roles of ADR-013. The application services connect with the
# runtime roles (the row-level-security policies are in force for them); the
# migration step uses the owner URL and the platform-admin service has its own
# credential. The owner URL reaches the "migrate" service only.
ENAMEL_APP_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_WORKER_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_MAINT_DB_PASSWORD=replace-with-a-strong-role-password
ENAMEL_ADMIN_DB_PASSWORD=replace-with-a-strong-role-password
DATABASE_MIGRATION_URL=postgresql://enamel:replace-with-a-strong-database-password@db:5432/enamel
# The runtime URLs of the compose services. The rollback of the role switch
# is to point these at the owner URL and restart the services.
API_DATABASE_URL=postgresql://enamel_app:replace-with-a-strong-role-password@db:5432/enamel
WORKER_DATABASE_URL=postgresql://enamel_worker:replace-with-a-strong-role-password@db:5432/enamel
MAINT_DATABASE_URL=postgresql://enamel_maint:replace-with-a-strong-role-password@db:5432/enamel
ADMIN_DATABASE_URL=postgresql://enamel_admin:replace-with-a-strong-role-password@db:5432/enamel
# The platform-admin service listens on its own port; the public web service
# does not proxy it.
ADMIN_PORT=8091

# Redis broker
REDIS_URL=redis://127.0.0.1:6380/0

# Production-shaped compose profile (deploy/.env has its own copy):
# WEB_PORT=8080
# SECURE_SSL_REDIRECT=false
# GUNICORN_WORKERS=3

# AI provider (offline mock mode by default; never commit real credentials).
# Keep AI_PROVIDER=mock and AI_MOCK_MODE=true for local tests/CI.
# The recommended free model pair lives in
# backend/apps/ai/evals/configs/free-models.json (measured, timestamped).
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_MODEL=
AI_MODEL=
AI_FALLBACK_MODEL=
# Embeddings are separate from chat: mock for CI, fastembed for real semantic
# vectors (optional dependency: pip install fastembed), openrouter only if an
# embedding model is configured on that account.
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# Refuse any configured model with paid pricing (the free-model guard).
AI_ALLOW_PAID=false
# Hard cap on total requests per benchmark run.
AI_BENCH_MAX_REQUESTS=150
# Reranker model used when RAG_RERANK=true (local ONNX cross-encoder).
AI_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
AI_DAILY_BUDGET_USD=0
AI_MOCK_MODE=true

# Retrieval. vector = cosine only; hybrid = cosine + Postgres full-text (RRF).
# Measured on the labelled set: vector recall@5 1.00, hybrid 1.00, rerank
# 0.96 at ~25x the latency, so rerank is off by default. RAG_MIN_SCORE is a
# permissive floor; the eval reports whether answerable/unanswerable scores
# actually separate for your embedding model.
RAG_MODE=hybrid
RAG_MIN_SCORE=0.2
RAG_RERANK=false
RAG_RERANKER=fastembed
RAG_HYBRID_CANDIDATES=30
RAG_RRF_K=60

# Adapters (deterministic local implementations; live credentials stay blank).
MESSAGING_ADAPTER=dev
PAYMENT_GATEWAY=sandbox
RCM_ENABLED=false

# Webhook and connector secrets.
# Development falls back to well-known placeholders; config.settings.prod
# refuses to start while any of these is empty or still a placeholder, so
# production must set all three.
PAYMENT_WEBHOOK_SECRET=
MESSAGING_WEBHOOK_SECRET=
CONNECTOR_KEY=
